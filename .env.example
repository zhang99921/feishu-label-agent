# 复制为 .env 并在本机填写。真实 .env 不提交 Git、不随运行包交付。
# 操作系统环境变量优先；不执行命令、不做 ${...} 插值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 支持 https://租户.feishu.cn/base/标识 或 /wiki/标识。
# Wiki 链接在未填写 APP_TOKEN 时，由只读接口解析；应用需具备对应 Wiki 访问权限。
FEISHU_BASE_URL=
# 可显式填写底层 Base token，避免额外 Wiki 解析权限；不是 wiki 节点 token。
FEISHU_APP_TOKEN=
# 优先使用此处指定的扫码流水表ID；留空时才读取 URL 中的 table 参数。
FEISHU_SCAN_TABLE_ID=
# 跨表只读校验：箱表与行表必须同时配置；留空时校验接口返回未配置。
FEISHU_BOX_TABLE_ID=
FEISHU_ROW_TABLE_ID=
# 事务账只读查询可选；单据引用的具体生成格式仍待核对。
FEISHU_TRANSACTION_TABLE_ID=
FEISHU_POLL_SECONDS=30
FEISHU_INCLUDE_BLANK_STATUS=false

# 查询副本：显式列出需要同步的表ID，以英文逗号分隔；不得留空默认拉取整份Base。
FEISHU_SYNC_TABLE_IDS=
# 每轮完整同步结束后等待60秒；失败退避，启动sync --watch才持续运行。
FEISHU_SYNC_SECONDS=60
# 轮询式增量：完整ID/修改时间清单 + 变更记录回读，依赖/未知字段的表仍完整读取。
FINDING_ASSISTANT_ENABLE_INCREMENTAL_SYNC=false
# 增量启用后仍至少每3600秒执行一轮所有业务字段的全量对账。
FEISHU_SYNC_FULL_SECONDS=3600
# 0关闭自动内容核验；例如3600为每轮巡检完成后至少等待1小时，下个同步轮次后再执行。
# 随sync --watch串行运行，启动后第一轮立即检查；无需额外定时器。
FINDING_ASSISTANT_REPLICA_CHECK_SECONDS=0
FINDING_ASSISTANT_SQL_STALE_SECONDS=300
# SQL检索需登录。可管理账号使用完整范围，普通账号按可核实的原生行列规则查询。
FINDING_ASSISTANT_ENABLE_SQL_QUERY=false
# 原生默认角色只在运维确认其实际语义后填写ID；不按名称或空成员列表猜测。
# 留空仍支持明确的直接用户角色；默认角色、部门/群组成员无法核实时拒绝SQL查询。
FEISHU_SQL_DEFAULT_ROLE_ID=
# 普通账号SQL行列权限映射先验收再启用；复杂条件或范围不明时仍拒绝，不降级全表。
FINDING_ASSISTANT_ENABLE_SQL_VISIBILITY=false

# 四档原生权限入口：填齐本租户配置后显式启用；不新增飞书字段或角色成员表。
FINDING_ASSISTANT_ENABLE_SCAN_API=false
# 新授权会话的绝对上限为12小时；到期仍需重新登录，不随操作无限续期。
# 应用已开通offline_access后，用户须重新授权以取得可轮换的刷新令牌。
FINDING_ASSISTANT_SESSION_SECONDS=43200
# 转仓自动预占：先核实完整业务读取范围、旧占用/冷却交接和旧写入程序停用，再显式开启。
# 仅准备并写入流水，不启用库存实际转仓或来源行码释放。
FINDING_ASSISTANT_ENABLE_TRANSFER_ALLOCATION=false
# 新组合位置分配；旧TRANSFER_ALLOCATION开关保留为兼容别名，两者均默认关闭。
FINDING_ASSISTANT_ENABLE_POSITION_ALLOCATION=false
FINDING_ASSISTANT_ENABLE_INVENTORY_EXECUTION=false
FEISHU_BOX_DETAILS_TABLE_ID=
FEISHU_TENANT_KEY=
# 必须与飞书开发者后台登记的一致，如 http://127.0.0.1:8001/auth/feishu/callback。
FEISHU_OAUTH_REDIRECT_URI=

# PostgreSQL 连接串可能包含密码，仅在服务器 .env 或部署环境填写。
FINDING_ASSISTANT_DATABASE_URL=
# Fernet 随机密钥；与数据库分开备份，不提交 Git。密钥丢失会使现存会话无法解密。
FINDING_ASSISTANT_TOKEN_KEY=

# 常驻HTTP/接收进程日志；相对路径基于进程工作目录。空值表示只输出到控制台。
# 默认每个进程角色一个日志文件，10MiB轮转，最多保留5个历史文件。
FINDING_ASSISTANT_LOG_DIR=logs
FINDING_ASSISTANT_LOG_MAX_BYTES=10485760
FINDING_ASSISTANT_LOG_BACKUPS=5
# 按UTC日期保留当天及之前29天；BACKUPS为旧配置兼容，不再按数量覆盖归档。
FINDING_ASSISTANT_LOG_RETENTION_DAYS=30

# 旧版实验入口的白名单，默认禁用；不填入正式表来启动旧测试流程。
FEISHU_LEGACY_APP_TOKEN=
FEISHU_LEGACY_TABLE_ID=
